# Copy thành .env rồi điền giá trị thật:  cp .env.example .env
# KHÔNG commit file .env (đã nằm trong .gitignore)

# Server
PORT=8000
ENVIRONMENT=development

# Security — đặt một chuỗi ngẫu nhiên dài, vd: python -c "import secrets; print(secrets.token_hex(16))"
AGENT_API_KEY=

# Redis (trong docker compose: redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0

# Rate limit: số request tối đa / 60 giây cho mỗi API key
RATE_LIMIT_PER_MINUTE=10

# Cost guard: ngân sách LLM mỗi ngày (USD)
DAILY_BUDGET_USD=1.0
